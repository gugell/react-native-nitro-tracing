{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrotracing"],
  "ios": {
    "iosModuleName": "NitroTracing"
  },
  "android": {
    "androidNamespace": ["nitrotracing"],
    "androidCxxLibName": "NitroTracing"
  },
  "autolinking": {
    "Tracing": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridTracing"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}

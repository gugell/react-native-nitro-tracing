{
  "name": "react-native-nitro-tracing",
  "version": "0.1.0",
  "description": "Bounded native performance recordings and explicit spans for React Native",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "react-native.config.js",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "cpp",
    "ios/**/*.h",
    "ios/**/*.m",
    "ios/**/*.mm",
    "ios/**/*.cpp",
    "ios/**/*.swift",
    "app.plugin.js",
    "nitro.json",
    "*.podspec",
    "README.md",
    "plugins.ts",
    "performance.ts",
    "sentry.ts",
    "release-profiler.ts",
    "scripts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "nitrogen": "nitrogen",
    "postinstall": "nitrogen",
    "test:native": "sh scripts/test-native.sh",
    "test": "jest --runInBand"
  },
  "keywords": [
    "react-native",
    "nitro"
  ],
  "author": "Margelo",
  "license": "MIT",
  "homepage": "https://nitro.margelo.com",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "nitrogen": "catalog:",
    "react-native-nitro-modules": "catalog:",
    "react-native": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "@types/react": "^19.2.15",
    "react-native-performance": "catalog:",
    "@sentry/react-native": "catalog:",
    "jest": "catalog:",
    "babel-jest": "catalog:",
    "@types/jest": "catalog:",
    "@babel/preset-typescript": "^7.25.0",
    "@babel/preset-env": "catalog:"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": ">=0.37.1",
    "react-native-performance": ">=6",
    "@sentry/react-native": ">=7"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "plugins": [
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "warn",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "semi": false
  },
  "peerDependenciesMeta": {
    "react-native-performance": {
      "optional": true
    },
    "@sentry/react-native": {
      "optional": true
    }
  }
}
